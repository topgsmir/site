{
  "name": "topgsm-api",
  "private": true,
  "scripts": {
    "dev": "pnpm run prisma:migrate && pnpm run prisma:seed:dev && nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "start": "nest start",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "test": "nest build && node --test \"dist/**/!(*.integration).spec.js\"",
    "test:integration": "nest build && node --test --test-concurrency=1 \"dist/**/*.integration.spec.js\"",
    "check": "pnpm run type-check && pnpm run lint && pnpm run test",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "node ../../scripts/generate-prisma.mjs",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:seed:dev": "prisma db seed -- --development"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/platform-socket.io": "12.0.1",
    "@nestjs/websockets": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@topgsm/shared-types": "workspace:*",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/multer": "1.4.12",
    "@types/node": "24.3.0",
    "@types/pg": "8.23.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
