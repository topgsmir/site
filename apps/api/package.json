{
  "name": "topgsm-api",
  "private": true,
  "scripts": {
    "dev": "pnpm run prisma:migrate && pnpm run prisma:seed:dev && nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "start": "nest start",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "test": "node --test --require ts-node/register src/common/http/api-exception.filter.spec.ts src/modules/auth/security.spec.ts src/modules/auth/platform-permission.spec.ts src/modules/bridge/bridge-security.spec.ts src/modules/bridge/bridge-adapters.spec.ts src/modules/blog/blog-manage.guard.spec.ts src/modules/blog/blog.service.spec.ts src/modules/coupon/coupon.spec.ts src/modules/goghdi/goghdi.spec.ts src/modules/media/media.service.spec.ts src/modules/product/product.service.spec.ts src/modules/realtime/realtime.spec.ts",
    "test:integration": "node --test --test-concurrency=1 --require ts-node/register src/modules/auth/auth.integration.spec.ts src/modules/blog/blog.integration.spec.ts src/modules/order/order-payout.integration.spec.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --schema src/prisma/schema/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema src/prisma/schema/schema.prisma",
    "prisma:seed": "prisma db seed --schema src/prisma/schema/schema.prisma",
    "prisma:seed:dev": "prisma db seed --schema src/prisma/schema/schema.prisma -- --development"
  },
  "prisma": {
    "seed": "ts-node src/prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.6",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.6",
    "@nestjs/platform-express": "10.4.6",
    "@nestjs/platform-socket.io": "10.4.6",
    "@nestjs/websockets": "10.4.6",
    "@prisma/client": "5.21.1",
    "@topgsm/shared-types": "workspace:*",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.0.1",
    "rxjs": "7.8.1",
    "sharp": "0.34.3",
    "socket.io": "4.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.6",
    "@nestjs/testing": "10.4.6",
    "@types/node": "22.8.1",
    "@types/multer": "1.4.12",
    "eslint": "9.39.5",
    "prisma": "5.21.1",
    "ts-node": "10.9.2",
    "typescript-eslint": "8.69.0",
    "typescript": "5.7.2"
  }
}
