# Shared
NODE_ENV=development
LANGUAGE_DEFAULT=fa

# Web
NEXT_PUBLIC_APP_NAME=TopGSM
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRIDGE_FEATURE_ENABLED=true
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_GOGHDI_SDK_URL=
NEXT_PUBLIC_GOGHDI_TENANT_ID=
NEXT_PUBLIC_GOGHDI_API_URL=
NEXT_PUBLIC_GOGHDI_SOCKET_URL=
NEXT_PUBLIC_GOGHDI_WIDGET_URL=

# API
API_PORT=4000
API_HOST=127.0.0.1
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://topgsm:topgsm@postgres:5432/topgsm
AUTH_COOKIE_DOMAIN=
TRUST_PROXY_HOPS=0
WEB_APP_URL=https://top-gsm.ir
DEFAULT_LOCALE=fa
GOGHDI_TENANT_SECRET=
GOGHDI_SUPPORT_DEPARTMENT=support

# Seller-owned Bridge services (generate independent 32-byte secrets)
BRIDGE_FEATURE_ENABLED=true
BRIDGE_CURRENT_KEY_ID=k1
BRIDGE_CREDENTIAL_KEYS=k1:replace-with-32-byte-base64-key
OTP_HMAC_KEY=replace-with-at-least-32-random-characters

# Zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=https://api.top-gsm.ir/api/payments/zarinpal/callback
ZARINPAL_REFUND_ACCESS_TOKEN=
LOCAL_PAYMENT_GATEWAY_ENABLED=false

# SMS.ir templates
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_OTP=
SMS_IR_TEMPLATE_SELLER_NEW_ORDER=
SMS_IR_TEMPLATE_BUYER_SUCCESS=
SMS_IR_TEMPLATE_BUYER_FAILURE=

# Realtime
SOCKET_CORS_ORIGIN=http://localhost:3000
