# Shared
NODE_ENV=development
LANGUAGE_DEFAULT=fa

# Web
NEXT_PUBLIC_APP_NAME=TopGSM
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRIDGE_FEATURE_ENABLED=true
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_GOGHDI_SDK_URL=
NEXT_PUBLIC_GOGHDI_TENANT_ID=
NEXT_PUBLIC_GOGHDI_API_URL=
NEXT_PUBLIC_GOGHDI_SOCKET_URL=
NEXT_PUBLIC_GOGHDI_WIDGET_URL=

# API
API_PORT=4000
API_HOST=127.0.0.1
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://topgsm:topgsm@postgres:5432/topgsm
MEDIA_ROOT=var/media

# Encrypted backup archives and restore journals. Mount BACKUP_ROOT on durable
# storage. Key-ring entries are base64-encoded 32-byte keys; keep old entries
# for as long as any archive encrypted with them must remain restorable.
BACKUP_ROOT=var/backups
BACKUP_MAX_ARCHIVE_BYTES=26843545600
BACKUP_RESTART_ENABLED=false
BACKUP_SAFETY_RETENTION_DAYS=7
BACKUP_APP_VERSION=0.1.0
BACKUP_ARCHIVE_CURRENT_KEY_ID=k1
BACKUP_ARCHIVE_CREDENTIAL_KEYS=k1:replace-with-independent-32-byte-base64-key
BACKUP_DESTINATION_CURRENT_KEY_ID=k1
BACKUP_DESTINATION_CREDENTIAL_KEYS=k1:replace-with-a-different-32-byte-base64-key
# Comma-separated private CIDRs or exact IPs that backup destinations may use.
# Private, loopback, and link-local targets are blocked when this is empty.
BACKUP_DESTINATION_ALLOWED_CIDRS=
# Optional absolute paths when PostgreSQL tools are not on PATH.
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
PSQL_BIN=psql
# Comma-separated UploadCenter download hostnames; use the same secret in its secure_link_md5 configuration.
UPLOAD_DOWNLOAD_HOSTS=uploads.example.com
UPLOAD_DOWNLOAD_SECRET=replace-with-an-independent-random-secret-of-at-least-32-bytes
AUTH_COOKIE_DOMAIN=
TRUST_PROXY_HOPS=0
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=
WEB_APP_URL=https://top-gsm.ir
DEFAULT_LOCALE=fa
GOGHDI_TENANT_SECRET=
GOGHDI_CURRENT_KEY_ID=k1
GOGHDI_CREDENTIAL_KEYS=k1:replace-with-independent-32-byte-base64-key

# Seller-owned Bridge services (generate independent 32-byte secrets)
BRIDGE_FEATURE_ENABLED=true
BRIDGE_CURRENT_KEY_ID=k1
BRIDGE_CREDENTIAL_KEYS=k1:replace-with-32-byte-base64-key
SERVICE_INPUT_CURRENT_KEY_ID=k1
SERVICE_INPUT_CREDENTIAL_KEYS=k1:replace-with-independent-32-byte-base64-key
AI_CURRENT_KEY_ID=k1
AI_CREDENTIAL_KEYS=k1:replace-with-independent-32-byte-base64-key
PAYMENT_CURRENT_KEY_ID=k1
PAYMENT_CREDENTIAL_KEYS=k1:replace-with-independent-32-byte-base64-key
SMS_CURRENT_KEY_ID=k1
SMS_CREDENTIAL_KEYS=k1:replace-with-independent-32-byte-base64-key
# Production should use a PostgreSQL role with SELECT only on ai_reporting views.
AI_DATABASE_URL=postgresql://topgsm_ai_reader:replace-me@postgres:5432/topgsm
OTP_HMAC_KEY=replace-with-at-least-32-random-characters

# Payment provider credentials are encrypted and configured in the admin panel.
# Keep only the independent PAYMENT_* encryption key ring in deployment secrets.
LOCAL_PAYMENT_GATEWAY_ENABLED=false

# Active shipping driver. Each driver owns its API contract and tenant provisioning.
SHIPPING_PROVIDER=amadast
AMADAST_API_KEY=
SHIPPING_CURRENT_KEY_ID=k1
SHIPPING_CREDENTIAL_KEYS=k1:replace-with-independent-32-byte-base64-key

# SMS.ir credentials are encrypted and configured in the admin panel. These
# values remain supported as a deployment-level fallback during migration.
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_OTP=
SMS_IR_TEMPLATE_SELLER_NEW_ORDER=
SMS_IR_TEMPLATE_BUYER_SUCCESS=
SMS_IR_TEMPLATE_BUYER_FAILURE=

# Realtime
SOCKET_CORS_ORIGIN=http://localhost:3000
